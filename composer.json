{
    "name": "leafs/lingo",
    "description": "Add multi language support to your Leaf applications with ease.",
    "keywords": [
        "translations",
        "localization",
        "multi-language",
        "i18n",
        "internationalization",
        "leaf",
        "php"
    ],
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "leafs/session": "*",
        "leafs/fs": "*",
        "symfony/yaml": "*"
    },
    "require-dev": {
        "pestphp/pest": "*",
        "mockery/mockery": "*"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Leaf\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "authors": [
        {
            "name": "Andr\u00e9 Rosa",
            "email": "crosa7000@gmail.com"
        },
        {
            "name": "Michael Darko",
            "email": "mychi.darko@gmail.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-v5.x": "5.0.x-dev"
        }
    }
}